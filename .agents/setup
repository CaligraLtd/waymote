#!/usr/bin/env bash
set -euo pipefail

download() {
    local url=$1 sha256=$2 output=$3
    curl --fail --location --silent --show-error --retry 5 --retry-all-errors \
        --connect-timeout 10 --output "$output" "$url"
    printf '%s  %s\n' "$sha256" "$output" | sha256sum --check --status
}

if [[ -s /etc/resolv.conf ]] \
    && [[ "$(tail -c 1 /etc/resolv.conf | od -An -tuC | tr -d ' ')" != 10 ]]; then
    printf '\n' | sudo tee -a /etc/resolv.conf >/dev/null
fi

sudo install -Dm0644 /dev/stdin /etc/apt/sources.list.d/waymote-trixie.sources <<'EOF'
Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie
Components: main contrib
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF
sudo install -Dm0644 /dev/stdin /etc/apt/preferences.d/waymote-trixie <<'EOF'
Package: *
Pin: release n=trixie
Pin-Priority: 100
EOF
sudo apt-get update
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends -t trixie \
    ca-certificates curl ffmpeg foot game-data-packager labwc libwayland-dev \
    ioquake3 libxkbcommon-dev lhasa pkg-config pulseaudio pulseaudio-utils \
    quake3 wayland-utils wlr-randr

sudo install -Dm0644 /dev/stdin /etc/sysctl.d/90-waymote-rtp.conf <<'EOF'
net.core.rmem_max = 8388608
EOF
sudo sysctl --system >/dev/null

if ! dpkg-query -W -f='${Status}' quake3-demo-data 2>/dev/null | grep -q 'install ok installed'; then
    temporary="$(mktemp -d)"
    (cd "$temporary" && game-data-packager quake3 \
        --package quake3-demo-data --download --force-install \
        --gain-root-command sudo)
    rm -rf "$temporary"
fi

if [[ "$(zig version 2>/dev/null || true)" != 0.16.0 ]]; then
    temporary="$(mktemp -d)"
    download \
        https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz \
        70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00 \
        "$temporary/zig.tar.xz"
    tar -xJf "$temporary/zig.tar.xz" -C "$temporary"
    sudo rm -rf /opt/zig-0.16.0
    sudo mv "$temporary/zig-x86_64-linux-0.16.0" /opt/zig-0.16.0
    sudo ln -sfn /opt/zig-0.16.0/zig /usr/local/bin/zig
    rm -rf "$temporary"
fi

if [[ "$(go version 2>/dev/null || true)" != "go version go1.26.5 linux/amd64" ]]; then
    temporary="$(mktemp -d)"
    download \
        https://go.dev/dl/go1.26.5.linux-amd64.tar.gz \
        5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053 \
        "$temporary/go.tar.gz"
    sudo rm -rf /opt/go-1.26.5
    sudo mkdir -p /opt/go-1.26.5
    sudo tar -xzf "$temporary/go.tar.gz" -C /opt/go-1.26.5 --strip-components=1
    sudo ln -sfn /opt/go-1.26.5/bin/go /usr/local/bin/go
    sudo ln -sfn /opt/go-1.26.5/bin/gofmt /usr/local/bin/gofmt
    rm -rf "$temporary"
fi
